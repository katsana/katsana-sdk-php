{
    "name": "katsana/katsana-sdk-php",
    "description": "KATSANA SDK for PHP",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "KATSANA Developer",
            "email": "developer@katsana.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Katsana\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Katsana\\Sdk\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravie/codex": "^5.0",
        "laravie/codex-security": "^1.1.2",
        "php-http/multipart-stream-builder": "^1.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "php-http/discovery": "^1.14.1",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "symfony/http-client": "^6.0 || ^7.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.3-dev",
            "dev-L13": "1.3-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
